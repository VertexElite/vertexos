# VertexOS audit rules — what we trace by default.
# Tuned for supply-chain attack detection per docs/supply-chain-defense.md.

# Buffer + failure mode (1 = print on full, 2 = panic; we use 1 to avoid DoS)
-b 8192
-f 1

# === AI agent credential files ===
# Any read of these is interesting context for forensics + DFIR.
-w /home -p w -k vertex_home_writes
-w /root/.claude -p rwa -k vertex_agent_credentials
-w /root/.gemini -p rwa -k vertex_agent_credentials
-w /root/.cursor -p rwa -k vertex_agent_credentials
-w /root/.config/claude -p rwa -k vertex_agent_credentials

# === Agent hook + config files (Miasma Level 3 + 5) ===
-w /etc/skel/.claude -p wa -k vertex_agent_hook
-a always,exit -F arch=b64 -S openat -F dir=/home -F name=.claude/settings.json -k vertex_agent_settings_open
-a always,exit -F arch=b64 -S openat -F dir=/home -F name=.mcp.json            -k vertex_agent_mcp_open
-a always,exit -F arch=b64 -S openat -F dir=/home -F name=CLAUDE.md            -k vertex_agent_ctx_open
-a always,exit -F arch=b64 -S openat -F dir=/home -F name=GEMINI.md            -k vertex_agent_ctx_open
-a always,exit -F arch=b64 -S openat -F dir=/home -F name=AGENTS.md            -k vertex_agent_ctx_open

# === Package-manager command execution ===
-w /usr/bin/npm   -p x -k vertex_pkg_npm
-w /usr/bin/pnpm  -p x -k vertex_pkg_pnpm
-w /usr/bin/pip   -p x -k vertex_pkg_pip
-w /usr/bin/pip3  -p x -k vertex_pkg_pip
-w /usr/bin/cargo -p x -k vertex_pkg_cargo
-w /usr/bin/gem   -p x -k vertex_pkg_gem
-w /usr/bin/xbps-install -p x -k vertex_pkg_xbps

# === Kernel module loading ===
-a always,exit -F arch=b64 -S init_module     -k vertex_module_load
-a always,exit -F arch=b64 -S finit_module    -k vertex_module_load
-a always,exit -F arch=b64 -S delete_module   -k vertex_module_unload

# === Identity changes ===
-w /etc/passwd     -p wa -k vertex_identity
-w /etc/shadow     -p wa -k vertex_identity
-w /etc/group      -p wa -k vertex_identity
-w /etc/sudoers    -p wa -k vertex_identity
-w /etc/sudoers.d/ -p wa -k vertex_identity

# === Privilege escalation surface ===
-w /etc/cron.d/     -p wa -k vertex_persistence
-w /etc/cron.daily/ -p wa -k vertex_persistence
-w /etc/cron.hourly/-p wa -k vertex_persistence
-w /etc/cron.weekly/-p wa -k vertex_persistence
-w /etc/crontab     -p wa -k vertex_persistence
-w /var/spool/cron/ -p wa -k vertex_persistence

# === Runit services (init persistence) ===
-w /etc/sv/                       -p wa -k vertex_init
-w /etc/runit/runsvdir/default/   -p wa -k vertex_init

# === Network configuration ===
-w /etc/nftables.conf -p wa -k vertex_net
-w /etc/resolv.conf   -p wa -k vertex_net
-w /etc/stubby/       -p wa -k vertex_net

# === Lock the audit config itself ===
-e 2
