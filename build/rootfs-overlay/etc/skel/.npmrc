# VertexOS default npm config — seeded into every new user's ~/.npmrc.
# Hardens against npm supply-chain attacks documented in
# docs/supply-chain-defense.md (Shai-Hulud, TrapDoor, Phantom-Gyp).
#
# To override per-project: `npm config --location=project set <key> <value>`.

# Disable preinstall / install / postinstall scripts by default.
# This single setting blocks the WHOLE PreInstall hook class — the most common
# malicious-npm payload delivery mechanism.
# Override per-package via `npm install --ignore-scripts=false foo` after vetting.
ignore-scripts=true

# Always require lockfile + verify integrity hash
package-lock=true
save-exact=true

# Run `npm audit` on every install — flag known CVEs in transitive deps
audit=true
audit-level=high

# Refuse to install from arbitrary git URLs / tarball URLs (Phantom-Gyp delivery vector)
# Note: as of npm 12 GitHub announced this is becoming default upstream too.
allow-same-version=false

# Default registry — pin to official. /etc/hosts pinning + stubby DoT enforce.
registry=https://registry.npmjs.org/
strict-ssl=true

# Prefer offline cache to reduce attack-surface trips
prefer-offline=true

# Production-only on `npm install` in CI contexts (no dev-deps unless asked)
# production=false  # disabled by default; CI sets via NPM_CONFIG_PRODUCTION env

# Fund/notification noise off
fund=false
update-notifier=false
