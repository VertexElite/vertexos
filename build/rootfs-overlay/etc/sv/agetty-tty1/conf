if [ -x /sbin/agetty -o -x /bin/agetty ]; then
	# Live ISO: auto-login the live 'vertex' user straight to the desktop.
	# On an INSTALLED system 'vertex' does not exist -> normal login prompt
	# (the user logs in, then /etc/skel/.bash_profile runs startx -> desktop).
	if [ "${tty}" = "tty1" ] && getent passwd vertex >/dev/null 2>&1; then
		GETTY_ARGS="--autologin vertex --noclear"
	else
		GETTY_ARGS="--noclear"
	fi
fi

BAUD_RATE=38400
TERM_NAME=linux
