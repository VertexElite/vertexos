#!/bin/sh
# VertexOS session wrapper. Fixes the lightdm user-session exit-1 loop on musl:
# under lightdm the session may not register with elogind, so XDG_RUNTIME_DIR /
# the session bus are missing and xfce4-session bails. We ensure both, then run
# XFCE inside a fresh D-Bus session. Also logs the incoming env for diagnosis.
LOG=/tmp/vtx-session.log
{
  echo "=== vtx-session start ==="
  echo "id: $(id 2>/dev/null)"
  echo "tty: $(tty 2>/dev/null)   DISPLAY=$DISPLAY"
  echo "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
  echo "XDG_SESSION_ID=$XDG_SESSION_ID  XDG_SEAT=$XDG_SEAT  XDG_SESSION_TYPE=$XDG_SESSION_TYPE"
  echo "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS"
} >"$LOG" 2>&1

# elogind normally provides XDG_RUNTIME_DIR via pam_elogind; if the lightdm
# session didn't register, create it so xfce4-session has a runtime dir.
if [ -z "$XDG_RUNTIME_DIR" ]; then
  XDG_RUNTIME_DIR="/run/user/$(id -u)"
  export XDG_RUNTIME_DIR
  mkdir -p "$XDG_RUNTIME_DIR" 2>>"$LOG"
  chmod 700 "$XDG_RUNTIME_DIR" 2>>"$LOG"
  echo "vtx-session: created XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" >>"$LOG"
fi

echo "vtx-session: starting XFCE..." >>"$LOG"
if command -v dbus-run-session >/dev/null 2>&1; then
  dbus-run-session -- startxfce4 >>"$LOG" 2>&1
else
  startxfce4 >>"$LOG" 2>&1
fi
echo "vtx-session: startxfce4 EXITED rc=$?" >>"$LOG"
